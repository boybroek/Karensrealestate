{
  "name": "karens-real-estate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node server.mjs",
    "preview": "npm run build && npm start",
    "check": "astro check",
    "test": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "demo": "node scripts/demo.mjs",
    "concept": "node scripts/build-concept.mjs",
    "feed:check": "node --experimental-strip-types scripts/feed-check.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "cf:dev": "npm run build:cf && wrangler dev",
    "cf:deploy": "npm run build:cf && wrangler deploy",
    "cf:demo": "node scripts/build-cf.mjs --demo && wrangler deploy --env demo",
    "api:dev": "cd api-worker && wrangler dev --port 8788 --test-scheduled",
    "api:deploy": "cd api-worker && wrangler deploy",
    "e2e:local": "node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/nodemailer": "^8.0.2",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "astro": "^7.4.11",
    "nodemailer": "^10.5.0"
  }
}
