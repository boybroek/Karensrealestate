# Karens Real Estate — runtime configuration.
# Copy to .env (never commit it) or set these in your hosting panel.
# The server refuses to start in production when a required value is missing.

NODE_ENV=production
PORT=4321
HOST=0.0.0.0

# Public URL of the site, WITHOUT trailing slash. Also needed at BUILD time
# (canonical URLs, hreflang, sitemap, Open Graph).            [required]
SITE_URL=https://www.karensrealestate.nl
# Redirect every other host name (e.g. the apex domain) here with a 301.  [optional]
CANONICAL_HOST=www.karensrealestate.nl

# Random secret for signing form tokens, min. 32 characters.    [required]
# Generate with:  openssl rand -hex 32
FORM_SECRET=

# --- E-mail notifications for form submissions (SMTP) ---       [required]
# Use the SMTP details of the mailbox provider (e.g. Microsoft 365, Google Workspace,
# TransIP, or a transactional service such as Postmark/Mailgun/Brevo).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS, enforced)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address; must be allowed to send for the domain (SPF/DKIM!)
MAIL_FROM="Website Karens Real Estate <website@karensrealestate.nl>"
# Recipient(s), comma separated
MAIL_TO=info@karensrealestate.nl

# --- Optional: forward every submission as signed JSON (CRM, Zapier, Make …) ---
FORMS_WEBHOOK_URL=
# Receiver verifies header X-KRE-Signature: sha256=HMAC_SHA256(body, secret)
FORMS_WEBHOOK_SECRET=

# Number of reverse proxies in front of Node (Caddy/nginx = 1). Needed for correct
# per-visitor rate limiting. Leave 0 when Node is exposed directly.
TRUST_PROXY_HOPS=1
# Extra origins allowed to post forms (comma separated), e.g. the apex domain.
ALLOWED_ORIGINS=https://karensrealestate.nl
# Max. form submissions per visitor per 10 minutes.
FORM_RATE_LIMIT=5

# Where undeliverable submissions wait for retry (outbox). Must be writable and persistent.
DATA_DIR=./data
OUTBOX_RETENTION_DAYS=14

# Development only: MAIL_TRANSPORT=file writes e-mails to DATA_DIR/dev-mail instead of sending.
# MAIL_TRANSPORT=file
