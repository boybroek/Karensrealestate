---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { type Lang, t } from '../i18n/index.ts';
import { site, osmEmbed, osmLink, mapsDirections, fullAddress } from '../content/site.ts';
import { CONCEPT } from '../content/listings.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const contactPage = { '@type': 'ContactPage', '@id': `${Astro.url.href}#contact`, mainEntity: { '@id': `${Astro.site!.origin}/#organization` } };
---
<BaseLayout lang={lang} page="contact" schema={[contactPage]}>
  <section class="container section co grid-2">
    <div>
      <p class="eyebrow rise">{c.ey}</p>
      <h1 class="display co__t rise rise-1">{c.coT}</h1>
      <p class="lead co__p rise rise-2">{c.coP}</p>
      <div class="co__tiles rise rise-3">
        <a href={`tel:${site.phone.e164}`}><span class="co__lbl">{d.common.callUs}</span><span class="co__val">{site.phone.display}</span></a>
        <a href={`mailto:${site.email}`}><span class="co__lbl">{d.common.email}</span><span class="co__val co__val--break">{site.email}</span></a>
      </div>
      <div class="co__map" data-reveal="240" data-osm={osmEmbed(site.map.lat, site.map.lon, 0.008, 0.0045)} data-title={c.mapTitle}>
        {CONCEPT ? (
          <a class="co__mapbtn" href={osmLink(site.map.lat, site.map.lon)} target="_blank" rel="noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>{d.concept.mapOpen}</span>
                    </a>
        ) : (
        <button type="button" class="co__mapbtn" data-load-map>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>{c.mapLoad}</span>
          <small>{c.mapNote}</small>
        </button>
        )}
      </div>
      <address class="co__addr">
        <span>{site.address.street}, {site.address.postalCode} {d.common.city} · {d.common.byAppt}</span>
        <a href={mapsDirections(fullAddress)} target="_blank" rel="noopener">{d.common.routeShort}<span class="visually-hidden"> {d.common.newWindow}</span></a>
      </address>
    </div>
    <div class="rise rise-2">
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<script>
  // Load the OpenStreetMap embed only on request (privacy + performance).
  const box = document.querySelector<HTMLElement>('[data-osm]');
  box?.querySelector('[data-load-map]')?.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = box.dataset.osm!;
    f.title = box.dataset.title ?? '';
    f.referrerPolicy = 'no-referrer';
    box.replaceChildren(f);
  });
</script>

<style>
  .co { padding-top: clamp(40px, 6vw, 80px); }
  .co .eyebrow { margin-bottom: 20px; }
  .co__t { font-size: clamp(42px, 5.4vw, 76px); margin-bottom: 24px; }
  .co__p { font-size: 18px; margin-bottom: 36px; }
  .co__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 24px; }
  .co__tiles a { background: #fff; padding: 22px; display: flex; flex-direction: column; gap: 6px; transition: background .25s; }
  .co__tiles a:hover { background: var(--mist); }
  .co__lbl { font-size: 12px; letter-spacing: .14em; font-weight: 600; color: var(--blue); }
  .co__val { font-size: 17px; font-weight: 600; color: var(--navy); }
  .co__val--break { word-break: break-all; }
  .co__map { border-radius: var(--radius); overflow: hidden; position: relative; aspect-ratio: 16 / 10; background: var(--mist) repeating-linear-gradient(135deg, #e4eaf0 0 12px, #dbe3eb 12px 24px); }
  .co__map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .co__mapbtn { text-decoration: none; position: absolute; inset: 0; width: 100%; border: 0; background: transparent; color: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-weight: 600; font-size: 16px; }
  .co__mapbtn span { background: #fff; padding: 10px 18px; border-radius: 999px; box-shadow: 0 6px 20px rgba(2, 31, 54, .12); transition: transform .25s var(--ease); }
  .co__mapbtn:hover span { transform: translateY(-2px); }
  .co__mapbtn small { font-weight: 400; font-size: 13px; color: var(--muted-2); }
  .co__addr { font-style: normal; display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; font-size: 15px; color: var(--muted); flex-wrap: wrap; }
  .co__addr a { font-weight: 600; }
</style>
