---
import View from '../../../views/Area.astro';
import { AREAS, type Area } from '../../../content/areas.ts';

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props as { area: Area };
---
<View lang="en" area={area} />
