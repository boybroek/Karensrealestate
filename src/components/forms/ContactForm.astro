---
import FormFrame from './FormFrame.astro';
import Field from './Field.astro';
import { type Lang, path, t } from '../../i18n/index.ts';
import { OPTIONS } from '../../lib/forms/schema.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const f = d.form;
const id = 'contact';
---
<FormFrame id={id} lang={lang} successTitle={d.contact.coThanks} successText={f.thanksP}>
  <div class="form__stack">
    <Field form={id} name="name" label={f.name} required autocomplete="name" maxlength={100} />
    <Field form={id} name="email" label={f.email} type="email" required autocomplete="email" maxlength={254} inputmode="email" />
    <Field form={id} name="phone" label={f.phone} type="tel" autocomplete="tel" maxlength={25} inputmode="tel" />
    <Field form={id} name="topic" label={f.coHelp} type="select" required options={OPTIONS.topic.map((v) => ({ value: v, label: f.options.topic[v] }))} />
    <Field form={id} name="message" label={f.msg} type="textarea" required rows={5} maxlength={2000} />
  </div>
  <div class="form__actions">
    <p class="form__privacy">{f.coPrivacy}<a href={path('privacy', lang)}>{d.nav.privacy.toLowerCase()}</a>.</p>
    <button type="submit" class="btn btn--primary btn--lg">{f.coSend}</button>
  </div>
</FormFrame>
