---
import FormFrame from './FormFrame.astro';
import Field from './Field.astro';
import ChipGroup from './ChipGroup.astro';
import Consent from './Consent.astro';
import { type Lang, t } from '../../i18n/index.ts';
import { OPTIONS } from '../../lib/forms/schema.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t(lang).form;
const id = 'verhuur';
const opts = <K extends keyof typeof f.options>(k: K, keys: readonly string[]) =>
  keys.map((v) => ({ value: v, label: (f.options[k] as Record<string, string>)[v] }));
---
<FormFrame id={id} lang={lang} steps={2} stepLabels={f.steps.verhuur} successTitle={f.vfThanks} successText={f.vfThanksP} successTheme="white">
  <div class="step" data-step="0">
    <h3 class="form__title" data-step-title>{f.vfHome}</h3>
    <div class="form__grid">
      <Field form={id} name="address" label={f.vfAddr} placeholder={f.vfAddrPh} required maxlength={120} autocomplete="street-address" />
      <Field form={id} name="postcode" label={f.vfZip} placeholder="2583 EM" required maxlength={7} autocomplete="postal-code" />
      <Field form={id} name="area" label={f.vfArea} placeholder={f.vfAreaPh} inputmode="numeric" maxlength={8} />
      <Field form={id} name="bedrooms" label={f.vfBed} type="select" options={[{ value: '', label: f.choose }, ...opts('bedrooms', OPTIONS.bedrooms)]} />
    </div>
    <ChipGroup form={id} name="propertyType" legend={f.vfType} options={opts('letType', OPTIONS.letType)} />
    <ChipGroup form={id} name="furnishing" legend={f.vfDel} options={opts('furnishing', OPTIONS.furnishing)} />
    <div class="form__grid mt">
      <Field form={id} name="availableFrom" label={f.vfAvail} type="date" />
      <Field form={id} name="rent" label={f.vfRent} placeholder={f.vfRentPh} inputmode="decimal" maxlength={15} />
    </div>
    <div class="form__actions form__actions--end">
      <div class="form__nav"><button type="button" class="btn btn--primary btn--lg" data-next>{f.next}</button></div>
    </div>
  </div>

  <div class="step" data-step="1">
    <h3 class="form__title" data-step-title>{f.vfYou}</h3>
    <div class="form__grid">
      <Field form={id} name="name" label={f.name} required autocomplete="name" maxlength={100} />
      <Field form={id} name="email" label={f.email} type="email" required autocomplete="email" maxlength={254} inputmode="email" />
      <Field form={id} name="phone" label={f.phone} type="tel" required autocomplete="tel" maxlength={25} inputmode="tel" />
    </div>
    <div class="form__stack mt">
      <Field form={id} name="message" label={f.msg} type="textarea" placeholder={f.vfMsgPh} maxlength={2000} />
    </div>
    <Consent form={id} lang={lang} />
    <div class="form__actions">
      <button type="button" class="btn btn--outline btn--lg" data-back>{f.back}</button>
      <div class="form__nav"><button type="submit" class="btn btn--primary btn--lg">{f.vfSubmit}</button></div>
    </div>
  </div>
</FormFrame>
