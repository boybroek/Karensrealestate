---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Flag from './Flag.astro';
import { type Lang, type PageKey, LANGS, NAV, alternates, path, t } from '../i18n/index.ts';
import { site } from '../content/site.ts';

interface Props { lang: Lang; page: PageKey | null }
const { lang, page } = Astro.props;
const d = t(lang);
const alts = page ? alternates(page) : { nl: '/', en: '/en/' };
const current = (k: PageKey) => (k === page ? 'page' : undefined);
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href={path('home', lang)} aria-label={d.common.homeLink}>
      <Image src={logo} alt={d.common.logoAlt} height={44} densities={[1, 2]} format="webp" loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav nav--desktop" aria-label={d.common.mainNav}>
      {NAV.map((k) => <a href={path(k, lang)} aria-current={current(k)}>{d.nav[k]}</a>)}
    </nav>

    <div class="header-actions">
      <a class="btn btn--outline btn--sm header-ctas" href={path('verhuren', lang)}>{d.common.ctaLet}</a>
      <a class="btn btn--primary btn--sm header-ctas" href={path('aanhuur', lang)}>{d.common.ctaFind}</a>
      <div class="lang-switch" role="group" aria-label={d.common.langGroup}>
        {LANGS.map((l) =>
          l === lang ? (
            <span aria-current="true" title={t(l).langName}><Flag code={l} /><span class="visually-hidden">{t(l).langName}</span></span>
          ) : (
            <a href={alts[l]} hreflang={l} lang={l} title={t(l).langName} aria-label={`${t(l).langName} – ${d.common.switchTo}`}><Flag code={l} /></a>
          ),
        )}
      </div>
      <a class="header-call" href={`tel:${site.phone.e164}`} aria-label={`${d.common.callUs.toLowerCase()}: ${site.phone.display}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-label-open={d.common.menu} data-label-close={d.common.closeMenu} aria-label={d.common.menu}>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label={d.common.mainNav}>
      {NAV.map((k) => <a href={path(k, lang)} aria-current={current(k)}>{d.nav[k]}</a>)}
    </nav>
    <div class="mobile-menu__ctas">
      <a class="btn btn--primary btn--lg" href={path('aanhuur', lang)}>{d.common.ctaFind}</a>
      <a class="btn btn--outline btn--lg" href={path('verhuren', lang)}>{d.common.ctaLet}</a>
    </div>
    <div class="mobile-menu__contact">
      <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</header>
