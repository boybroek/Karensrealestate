---
import Art from './Art.astro';
import type { Listing } from '../content/listings.ts';
import { mapsDirections, osmEmbed } from '../content/site.ts';
import { type Lang, t } from '../i18n/index.ts';

interface Props { listing: Listing; lang: Lang; delay?: number; headingLevel?: 'h2' | 'h3'; showAvailability?: boolean }
const { listing: l, lang, delay = 0, headingLevel = 'h3', showAvailability = false } = Astro.props;
const d = t(lang).aanbod;
const H = headingLevel;
const nf = new Intl.NumberFormat(lang === 'nl' ? 'nl-NL' : 'en-GB');
const city = lang === 'en' && l.city === 'Den Haag' ? 'The Hague' : l.city;
const avail = l.available === 'now' ? d.available.now : l.available === 'option' ? d.available.option
  : `${d.available.from} ${new Date(l.available + 'T12:00:00Z').toLocaleDateString(lang === 'nl' ? 'nl-NL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`;
const mapUrl = l.lat && l.lon ? osmEmbed(l.lat, l.lon) : null;
const id = `listing-${l.id}`;
---
<div data-reveal={delay} data-listing data-wijk={l.neighbourhood}>
  <article class="lcard" aria-labelledby={`${id}-t`}>
    <div class="lcard__media">
      <Art alt={`${l.address}, ${l.neighbourhood}`} ratio="4-3" sizes="(min-width: 1100px) 420px, 100vw" />
      {mapUrl && <div class="lcard__map" data-map-src={mapUrl} data-map-title={`${d.mapOf} ${l.address}`}></div>}
      <span class:list={['lcard__status', l.status === 'option' && 'lcard__status--option']}>{d.status[l.status]}</span>
      {mapUrl && (
        <div class="lcard__toggle" role="group" aria-label={d.viewToggle}>
          <button type="button" aria-pressed="true" data-view="photo">{d.photo}</button>
          <button type="button" aria-pressed="false" data-view="map">{d.map}</button>
        </div>
      )}
    </div>
    <div class="lcard__body">
      <H class="lcard__t" id={`${id}-t`}>{l.url ? <a href={l.url} target="_blank" rel="noopener">{l.address}</a> : l.address}</H>
      <p class="lcard__loc">{l.neighbourhood}, {city}</p>
      <div class="lcard__row">
        <span class="lcard__price">€ {nf.format(l.rent)} <span>{d.pm}</span></span>
        <span class="lcard__meta">{l.area} m² · {l.bedrooms} {d.bed}</span>
      </div>
      <div class="lcard__foot">
        <a href={mapsDirections(`${l.address}, ${l.city}`)} target="_blank" rel="noopener">{t(lang).common.route}</a>
        {showAvailability && <span class="lcard__avail">{avail}</span>}
      </div>
    </div>
  </article>
</div>

<style>
  .lcard { background: #fff; color: var(--ink); border-radius: var(--radius); overflow: hidden; box-shadow: 0 1px 0 rgba(4, 58, 99, .08); transition: transform .45s var(--ease), box-shadow .45s var(--ease); height: 100%; }
  .lcard:hover { transform: translateY(-6px); box-shadow: 0 30px 60px rgba(2, 31, 54, .14); }
  :global(.bg-navy) .lcard:hover { box-shadow: 0 30px 60px rgba(0, 0, 0, .25); }
  .lcard__media { position: relative; }
  .lcard__media :global(.art) { border-radius: 0; }
  .lcard__map { position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease; pointer-events: none; background: var(--mist); }
  .lcard__map.is-on { opacity: 1; pointer-events: auto; }
  .lcard__map :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .lcard__status { position: absolute; top: 14px; left: 14px; background: var(--navy); color: #fff; font-size: 11px; letter-spacing: .12em; font-weight: 600; padding: 6px 10px; border-radius: 2px; }
  .lcard__status--option { background: #5d6d7a; }
  .lcard__toggle { position: absolute; top: 12px; right: 12px; display: none; background: rgba(255, 255, 255, .95); border-radius: 999px; padding: 3px; box-shadow: 0 4px 14px rgba(2, 31, 54, .15); }
  :global(.js) .lcard__toggle { display: flex; }
  .lcard__toggle button { border: 0; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 600; background: transparent; color: var(--navy); transition: background .3s, color .3s; }
  .lcard__toggle button[aria-pressed='true'] { background: var(--navy); color: #fff; }
  .lcard__body { padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 6px; }
  .lcard__t { font-family: var(--font-serif); font-weight: 500; font-size: 24px; color: var(--navy); line-height: 1.2; }
  .lcard__t a { color: inherit; }
  .lcard__loc { font-size: 15px; color: var(--muted); }
  .lcard__row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--line); flex-wrap: wrap; }
  .lcard__price { font-size: 20px; font-weight: 600; color: var(--navy); }
  .lcard__price span { font-size: 14px; font-weight: 400; color: var(--muted); }
  .lcard__meta { font-size: 14px; color: var(--muted); }
  .lcard__foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 8px; flex-wrap: wrap; font-size: 14px; }
  .lcard__foot a { font-weight: 600; }
  .lcard__avail { font-size: 13px; color: var(--muted-3); }
</style>
